# Beskar Shelf app settings (Vite-prefixed vars are exposed to the browser)
VITE_APP_NAME=Beskar Shelf
VITE_DEFAULT_SERVER_URL=
VITE_ABS_PROXY_BASE=/abs
VITE_DYNAMIC_PROXY_ENABLED=false

# Optional pre-filled credentials for the login screen. Vite inlines these
# into the client bundle at build time, so they are visible to anyone who
# loads the site. Only use them for a public demo account (e.g. the
# audiobooks.dev "demo" / "demo" account). NEVER set real credentials.
VITE_DEMO_USERNAME=
VITE_DEMO_PASSWORD=

# Optional Audiobookshelf API values for local tooling and dev proxying
# ABS_URL="https://your-audiobookshelf-instance"
# ABS_TOKEN="your-api-token"
# ABS_LIBRARY_ID="your-library-id"

# Analytics script injected into index.html at container/server startup
# ANALYTICS_SCRIPT=<script defer src="https://your-umami-instance/script.js" data-website-id="your-id"></script>

# Docker Compose deployment settings
IMAGE_NAME=beskar-shelf
CONTAINER_NAME=beskar-shelf-pwa
APP_PORT=4173
ABS_UPSTREAM=https://books.example.com
